# Application
APP_BASE_URL=http://localhost:3000

# MongoDB Atlas (required when database features or the database health check are used)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=make_my_marriage

# Authentication (required when custom authentication is implemented)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 (required when storage features are implemented)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PRIVATE_BUCKET=make-my-marriage-private
R2_PUBLIC_BUCKET=make-my-marriage-public
R2_PUBLIC_BASE_URL=https://media.example.com

# Resend (required when email features are implemented)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Make My Marriage <noreply@example.com>
# Optional city/state suggestions in wedding setup. Keep this server-side.
GEOAPIFY_API_KEY=
# Password recovery uses RESEND_API_KEY and EMAIL_FROM above.
# EMAIL_FROM must be a Resend-verified sender. APP_BASE_URL must be the public
# HTTPS app URL in production; links are never generated from request headers.
